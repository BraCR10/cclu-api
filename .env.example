PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cclu

# Leave empty here. The server refuses to start until it is set, which is the
# point: a placeholder secret would sign perfectly valid tokens in silence.
# Generate one with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=2h

# How long a session lasts when somebody ticks "mantener la sesión iniciada" in
# the form. Both the token and the cookie are given the same span.
REMEMBERED_SESSION_DAYS=30

# The exact origin of cclu-web. It is the only origin allowed to send the
# session cookie, so a wildcard is not an option here.
WEB_ORIGIN=http://localhost:3000

# true in every deployed environment. false only for local http development,
# where the browser would otherwise refuse to store a Secure cookie.
COOKIE_SECURE=false

# true when the API answers through a reverse proxy. Wrong either way is costly;
# docs/architecture.md explains both directions.
TRUST_PROXY=false

# Where files live when no bucket is configured, which is what a development
# machine uses. A deployed environment sets the S3_* group instead and files go
# to the bucket. API_PUBLIC_URL is the address a stored file is handed out
# under, so it has to be the address the browser reaches the API on.
FILE_STORAGE_DIRECTORY=.file-storage
API_PUBLIC_URL=http://localhost:4000

# Outgoing mail. Nodemailer speaks SMTP to whichever server the chamber
# provides; any SMTP server works, including one meant for testing.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587

# true only on port 465, which speaks TLS from the first byte. On 587 and 25
# the connection upgrades with STARTTLS and this stays false.
SMTP_SECURE=false

SMTP_USER=
SMTP_PASSWORD=

# The sender the recipient sees. It accepts the "Name <address>" form, and
# the name itself is read by a person, so it stays in Spanish.
MAIL_FROM=Cámara de Comercio de La Unión <no-reply@cclu.cr>

# S3 compatible file storage. The endpoint is configurable so the chamber can
# move to any compatible provider without touching the service layer.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# true on providers that serve every bucket from one address and name the
# bucket in the path, such as MinIO. false on Amazon S3.
S3_FORCE_PATH_STYLE=false
