{
  "info": {
    "name": "cclu-api",
    "description": "Manual testing collection for the CCLU API. Every endpoint lives in the folder of the module that owns it. The collection stores no credentials: create a Postman environment of your own and set the variables this collection declares.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "adminEmail",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "cantonId",
      "value": ""
    },
    {
      "key": "sectorId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "description": "Service and database reachability. Not part of the domain.",
      "item": [
        {
          "name": "Get service health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Returns 200 with \"database\": \"connected\" when the API reached MongoDB, and 503 with \"database\": \"disconnected\" when the process started but the connection is down."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Sign in as administrator",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/admin/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "admin", "login"]
            },
            "description": "Answers 204 and sets the session cookie, which Postman keeps in its jar and returns on its own. Invalid credentials always answer 401 with the same message, whether or not the address is an account. Ten failures from one address within fifteen minutes answer 429."
          },
          "response": []
        },
        {
          "name": "Get current identity",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "Returns the identity behind the session cookie. Postman stores the cookie on sign in and sends it back on its own, so there is nothing to paste here."
          },
          "response": []
        },
        {
          "name": "Sign out",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            },
            "description": "Clears the session cookie. Needs no authentication, so an expired session can still be closed."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Members",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"comercio@ejemplo.cr\",\n  \"phone\": \"22000000\",\n  \"canton\": \"{{cantonId}}\",\n  \"location\": \"Frente al parque\",\n  \"sector\": \"{{sectorId}}\",\n  \"memberType\": \"business\",\n  \"identificationType\": \"legal_entity_id\",\n  \"identificationNumber\": \"3101000000\",\n  \"businessName\": \"Nombre comercial\",\n  \"businessDescription\": \"Descripcion breve\",\n  \"password\": \"una-contrasena-larga\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/members",
              "host": ["{{baseUrl}}"],
              "path": ["api", "members"]
            },
            "description": "Public, since nobody has an account yet. Answers 201 with the identifier alone. Role and application status are set by the server and ignored if sent. A repeated identifier answers 409 with a message that names nothing."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Catalogs",
      "item": [
        {
          "name": "List cantons",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cantons",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cantons"]
            },
            "description": "Closed list the registration form offers. Public."
          },
          "response": []
        },
        {
          "name": "List sectors",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sectors",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sectors"]
            },
            "description": "Closed list the registration form offers. Public."
          },
          "response": []
        }
      ]
    }
  ]
}
