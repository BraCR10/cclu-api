{
  "info": {
    "name": "cclu-api",
    "description": "Manual testing collection for the CCLU API. Every endpoint lives in the folder of the module that owns it. The collection stores no credentials: create a Postman environment of your own and set the variables this collection declares.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "adminEmail",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "cantonId",
      "value": ""
    },
    {
      "key": "sectorId",
      "value": ""
    },
    {
      "key": "memberEmail",
      "value": ""
    },
    {
      "key": "memberPassword",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "description": "Service and database reachability. Not part of the domain.",
      "item": [
        {
          "name": "Get service health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Returns 200 with \"database\": \"connected\" when the API reached MongoDB, and 503 with \"database\": \"disconnected\" when the process started but the connection is down."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Sign in as administrator",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/admin/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "admin", "login"]
            },
            "description": "Answers 204 and sets the session cookie, which Postman keeps in its jar and returns on its own. Invalid credentials always answer 401 with the same message, whether or not the address is an account. Ten failures from one address within fifteen minutes answer 429."
          },
          "response": []
        },
        {
          "name": "Sign in as member",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{memberEmail}}\",\n  \"password\": \"{{memberPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/member/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "member", "login"]
            },
            "description": "204 and the session cookie when the application is approved and the account active. 401 with one message for a wrong password or an address that is not an account. 403 with a reason once the password was right but the application is pending or rejected, or the account suspended."
          },
          "response": []
        },
        {
          "name": "Get current identity",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "Returns the identity behind the session cookie. Postman stores the cookie on sign in and sends it back on its own, so there is nothing to paste here."
          },
          "response": []
        },
        {
          "name": "Sign out",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            },
            "description": "Clears the session cookie. Needs no authentication, so an expired session can still be closed."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Members",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"comercio@ejemplo.cr\",\n  \"phone\": \"22000000\",\n  \"canton\": \"{{cantonId}}\",\n  \"location\": \"Frente al parque\",\n  \"sector\": \"{{sectorId}}\",\n  \"memberType\": \"business\",\n  \"identificationType\": \"legal_entity_id\",\n  \"identificationNumber\": \"3101000000\",\n  \"businessName\": \"Nombre comercial\",\n  \"businessDescription\": \"Descripcion breve\",\n  \"password\": \"una-contrasena-larga\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/members",
              "host": ["{{baseUrl}}"],
              "path": ["api", "members"]
            },
            "description": "Public, since nobody has an account yet. Answers 201 with the identifier alone. Role and application status are set by the server and ignored if sent. A repeated identifier answers 409 with a message that names nothing."
          },
          "response": []
        },
        {
          "name": "Upload own logo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contentType\": \"image/png\",\n  \"content\": \"<base64, no data: prefix required>\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/members/me/logo",
              "host": ["{{baseUrl}}"],
              "path": ["api", "members", "me", "logo"]
            },
            "description": "Requires a member session. Decodes the base64 content, stores it in S3 under member-logos/, and answers with a signed address good for a few minutes. Replaces whatever logo the member had before, key or legacy text address alike."
          },
          "response": []
        },
        {
          "name": "Remove own logo",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/members/me/logo",
              "host": ["{{baseUrl}}"],
              "path": ["api", "members", "me", "logo"]
            },
            "description": "Requires a member session. Answers 204 whether or not a logo was set."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Membership",
      "item": [
        {
          "name": "Get monthly fee",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/membership/fee",
              "host": ["{{baseUrl}}"],
              "path": ["api", "membership", "fee"]
            },
            "description": "Requires a member or administrator session. Answers { amount } or { amount: null } while unconfigured."
          },
          "response": []
        },
        {
          "name": "Set monthly fee",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 15000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/membership/fee",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "membership", "fee"]
            },
            "description": "Requires an administrator session. The new amount applies to payments registered from this moment on."
          },
          "response": []
        },
        {
          "name": "Get own membership",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/members/me/membership",
              "host": ["{{baseUrl}}"],
              "path": ["api", "members", "me", "membership"]
            },
            "description": "Requires a member session. Answers type free|paid, paidUntil, the configured fee and both benefit lists."
          },
          "response": []
        },
        {
          "name": "Register a payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contentType\": \"application/pdf\",\n  \"content\": \"<base64>\",\n  \"paidAt\": \"2026-09-20\",\n  \"detail\": \"Transferencia SINPE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/members/me/payments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "members", "me", "payments"]
            },
            "description": "Requires a member session and a configured fee. The receipt (image or PDF) lands in S3 under payment-receipts/. Registers pending and notifies the administrators."
          },
          "response": []
        },
        {
          "name": "List own payments",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/members/me/payments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "members", "me", "payments"]
            },
            "description": "Requires a member session. Newest first, each with a freshly signed receipt address."
          },
          "response": []
        },
        {
          "name": "List pending payments (admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/payments/pending",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "payments", "pending"]
            },
            "description": "Requires an administrator session. Oldest first, each with the member beside it."
          },
          "response": []
        },
        {
          "name": "Approve a payment (admin)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/payments/:paymentId/approve",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "payments", ":paymentId", "approve"],
              "variable": [
                {
                  "key": "paymentId",
                  "value": ""
                }
              ]
            },
            "description": "Requires an administrator session. Extends the membership one month from the approval and notifies the member. An already decided payment answers 409."
          },
          "response": []
        },
        {
          "name": "Reject a payment (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"El monto no coincide\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/payments/:paymentId/reject",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "payments", ":paymentId", "reject"],
              "variable": [
                {
                  "key": "paymentId",
                  "value": ""
                }
              ]
            },
            "description": "Requires an administrator session and a reason, which the member receives by email."
          },
          "response": []
        },
        {
          "name": "List a member's payments (admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/members/:memberId/payments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "members", ":memberId", "payments"],
              "variable": [
                {
                  "key": "memberId",
                  "value": ""
                }
              ]
            },
            "description": "Requires an administrator session."
          },
          "response": []
        },
        {
          "name": "List memberships (admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/memberships?state=active",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "memberships"],
              "query": [
                {
                  "key": "state",
                  "value": "active",
                  "description": "active | inactive; omit for all"
                }
              ]
            },
            "description": "Requires an administrator session. Every approved member with the membership their payments add up to."
          },
          "response": []
        }
      ]
    },
